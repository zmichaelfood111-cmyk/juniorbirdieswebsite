.contact_number_mobile,.mobile_viewhd {
    display: none
}

.dek_view_hd {
    display: block
}

@media (min-width: 768px) {
    .container {
        min-width:94%;
        margin: 0 auto
    }
}

@media (min-width: 991px) and (max-width:1024px) {
    .navbar .navbar-nav .nav-item {
        padding:10px 10px 10px 0
    }

    .game_decription {
        height: 450px
    }

    .game_decription .game_img img {
        width: 250px;
        height: 250px
    }

    .about_power2 .about-us-banner img {
        height: 100%
    }

    .abot-content p:first-child {
        padding-right: 10px
    }

    .abot-content img {
        position: static
    }
}

@media (min-width: 991px) and (max-width:1250px) {
    .crystal_img {
        height:100%
    }

    .crytal_mats3 {
        height: 420px
    }

    .crytal_mats2 {
        padding: 10px 20px 20px
    }

    .crytal_mats_txt p {
        font-size: 16px;
        margin-bottom: 0
    }

    .crytal_mats_txt h2 {
        font-size: 6vw;
        line-height: 6rem
    }

    .navbar .navbar-nav .nav-link {
        font-size: 10px
    }
}

@media (max-width: 991px) {
    .t_cont {
        padding:10px!important
    }

    .navbar .navbar-nav .nav-link,
    .navbar .navbar-nav .nav-item {
        background: transparent !important;
        -webkit-tap-highlight-color: transparent;
    }

    .navbar .navbar-nav .nav-link:focus,
    .navbar .navbar-nav .nav-link:active,
    .navbar .navbar-nav .nav-link:hover {
        background-color: transparent !important;
        outline: none;
        box-shadow: none;
    }

    .contact_number_mobile {
        display: block;
        position: absolute;
        right: 15%;
        background: #fff;
        border-radius: 20px;
        padding: 4px 15px;
        top: 20px;
        font-size: 16px
    }

    .contact_number_mobile a {
        color: #000
    }

    .text {
        font-size: 90px;
        line-height: 5rem;
        text-align: center
    }

    .about_power2 .about-us-banner img,.personalized_text p {
        height: auto
    }

    .navbar-toggler:focus {
        box-shadow: unset
    }

    .navbar-toggler {
        font-size: unset;
        line-height: 1;
        background-color: transparent;
        border: unset;
        border-radius: unset;
        transition: box-shadow .15s ease-in-out
    }

    .hamburger:hover span.inner-ham-b:after,.hamburger:hover span.inner-ham-b:before {
        width: 31px
    }

    .hamburger.close span.inner-ham-b:before {
        top: 19px
    }

    .hamburger.close span.inner-ham-b:after {
        bottom: 15px
    }

    .hamburger span.inner-ham-b:after,.hamburger span.inner-ham-b:before,.inner-ham {
        background: #fff
    }

    .logo_div_mob,nav.navbar,nav.open {
        background: #000000 !important;
    }

    .logo_div_mob {
        width: 102px;
        align-items: center;
        justify-content: center;
        padding: 12px 9px 6px;
        border-radius: 0 0 90px 90px;
        display: flex;
        position: absolute;
        top: 3px;
        z-index: 2
    }

    .game_redirect,.navbar-expand-lg .navbar-collapse {
        z-index: 1
    }

    .logo_div_mob a {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0
    }

    .navbar-brand img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }

    .navbar .navbar-collapse {
        display: block !important;
        max-height: 0;
        overflow: hidden;
        background: #000000;
        width: 100%;
        opacity: 0;
        padding-bottom: 0;
        transition: max-height .6s ease, opacity .6s ease, padding-bottom .6s ease;
    }

    .navbar .navbar-collapse.collapsing {
        max-height: 0;
        opacity: 0;
        padding-bottom: 0;
        transition: max-height .6s ease, opacity .6s ease, padding-bottom .6s ease;
    }

    .navbar .navbar-collapse.show {
        max-height: 400px;
        opacity: 1;
        background: #000000;
        padding-bottom: 20px;
    }

    .navbar .navbar-nav.navbar_one {
        padding-top: 0;
        margin-top: 50px;
        width: 100%
    }

    .navbar-nav {
        align-items: flex-start
    }

    .navbar .navbar-nav .nav-item {
        padding: 10px;
        border-bottom: 1px solid #ffffff5c;
        width: 100%
    }

    .navbar .navbar-nav .nav-link {
        color: #fff
    }

    nav.navbar {
        align-items: start;
        transition: opacity .35s,visibility .35s,height .35s;
        height: auto;
    }

    nav.open {
        height: auto;
        transition: height .35s
    }

    /* Disable desktop scroll slide behavior on mobile */
    nav.scrolled .navbar_one,
    nav.scrolled .navbar_two,
    nav.scrolled .logo_div {
        transform: none !important;
        opacity: 1 !important;
        left: 50% !important;
    }

    .navbar-toggler {
        padding: 17px 0
    }

    .scroll_sec {
        bottom: 8%
    }

    .h2 {
        font-size: 70px;
        margin-bottom: 40px;
        line-height: 70px
    }

    .pad80,.registration_hd h2 {
        padding: 60px 0
    }

    .game_decription h3,.game_redirect {
        padding: 20px 30px
    }

    .registration_arrow svg {
        right: -8px;
        height: 60px
    }

    .am_slide .slick-slide {
        margin: 0 10px;
        height: auto
    }

    .am_slide .slick-list {
        margin: 0 -10px
    }

    .game_decription {
        height: 450px;
        position: relative
    }

    .game_decription::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgb(0 0 0 / 15%)
    }

    .game_decription .game_img img {
        width: 100%;
        height: 100%;
        border-radius: unset
    }

    .personalized_text p {
        padding: 20px 0 0
    }

    .train_sec {
        bottom: 0;
        background-color: #000000a3
    }

    .our_value .row .col-md-6,.train_smater3 {
        margin-top: 30px
    }

    .chairman_message_data .h2,.chairman_message_data .h2 br,.footer-social-icon .ltd-n,.footer_img {
        display: none
    }

    .footer_links ul li a,.footer_links ul li.address_data p {
        font-size: 13px
    }

    .footer_links p::after {
        width: 25px
    }

    .footer_data.pad80 {
        padding: 60px 0 40px
    }

    .contact_footer {
        margin: 15px 0 40px
    }

    .contact_footer .gap {
        width: 30px;
        margin: 12px 15px;
        background: #f7ea2d
    }

    .footer_heading .registration_arrow2 {
        width: 70px
    }

    a.terms1::after {
        right: -27px
    }

    .timeing li {
        width: 300px;
        font-size: 14px;
        letter-spacing: 1px;
        left: 0;
    }

    .timeing li:first-child div {
        width: 15%;
    }

    .timeing li div {
        width: 25%;
        margin: 0
    }

    .timeing_data {
        border-bottom: 1px solid grey;
        width: 110.6%;
        background: #000;
        right: -10.5%
    }

    .banerwdth {
        background-position: center 52px
    }

    .registration_inner {
        background: rgb(27 25 78 / 70%)
    }

    .abot-content p:first-child {
        padding-right: 0;
        font-size: 18px;
        line-height: inherit;
        padding-top: 15px
    }

    .our_vision h3 {
        font-size: 60px
    }

    .our_vision .our_vission_inner2 .registration_arrow2 svg {
        width: 11px;
        right: 7px
    }

    .our_vision .our_vission_inner2 .regis_arrow {
        height: 1px
    }

    .chairman_message .res_hd {
        display: block
    }

    .abot-content p {
        margin-bottom: 15px
    }
